type ReadResult {
	case RPCError(err: ErrorCodes);
	case Success(method: string, params: JsonNav);
}

class Communication(conn: IOStream<byte>) {
	def log = Logger.new("packet");
	def rpc = RPC.new(conn);

	var sent_id = 0;

	def read() -> ReadResult {
		match (rpc.readJson()) {
			Fail(e) => return ReadResult.RPCError(e);
			Success(data) => {
				var r = JsonNav.new("packet", null, data);
				var method = r.readS("method");
				var params = r.readOD("params", null);
				if (!r.ok) return ReadResult.RPCError(ErrorCodes.PARSE_ERROR);
				if (Log.packet) {
					var title = Strings.format1("Read \"%s\":", method);
					if (params != null) {
						log.putBlock(title, Logger.putJson(_, null, params.obj));
					} else {
						log.puts(title);
					}
				}
				return ReadResult.Success(method, params);
			}
		}
	}

	def sendResult(result: JsonValue) {
		rpc.sendJson(newOutgoingData().add("result", result).build());
	}

	def sendError(err: ErrorCodes, message: string) {
		var error = JsonBuilder.new().num("code", err.code).str("message", message).build();
		rpc.sendJson(newOutgoingData().add("error", error).build());
	}

	def sendSimpleError(err: ErrorCodes) {
		sendError(err, err.name);
	}

	private def newOutgoingData() -> JsonBuilder {
		return JsonBuilder.new().num("id", sent_id++);
	}
}
