class V3LanguageServer(config: ServerConfig, conn: IOStream<byte>) {
	def session = LSPSession.new(config, conn);

	def run() -> int {
		// Note that event handlers registered here are registered and fired after
		// the handlers from the session lifecycle.
		registerEvents();

		return session.loop();
	}

	private def registerEvents() {
		session.register("initialize", initialize);
		session.register("shutdown", shutdown);
	}

	private def initialize(params: JsonNav) {
		// Read client info if needed:
		// var process_id = params.readN("processId");
		// var client_info = params.readOD("clientInfo", null);
		// var root_path = params.readS("rootPath");

		var result = JsonBuilder.new()
			.add("capabilities", getServerCapabilities())
			.add("serverInfo", JsonBuilder.new()
				.str("name", "Virgil Server :3")
				.str("version", "0.1.0")
				.build())
			.build();
		session.comm.sendResult(result);
	}

	private def shutdown(params: JsonNav) {
		session.comm.sendResult(JsonValue.Null);
	}

	private def getServerCapabilities() -> JsonValue {
		return JsonBuilder.new()
			.add("textDocumentSync", JsonBuilder.new()
				.boo("openClose", true)
				.num("change", TextDocumentSyncKind.NONE.v)
				.build())
			.build();
	}
}
